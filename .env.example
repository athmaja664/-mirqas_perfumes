# Mirqas Perfumes Environment Configuration

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mirqasperfumes_db
DB_USER=root
DB_PASSWORD=your_password
DB_SSL=false

# Initial Admin Configuration
ADMIN_NAME="Mirqas Admin"
ADMIN_EMAIL=admin@mirqasperfumes.com
ADMIN_PASSWORD=your_secure_password_min_10_chars

# Storage Configuration
# Set STORAGE_PROVIDER=local for persistent server disk (e.g., company VPS or local server)
# When deploying to Vercel, set BLOB_READ_WRITE_TOKEN for persistent cloud storage
STORAGE_PROVIDER=
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Client-Side Developer Tools / Inspect Protection (set true to disable right-click & inspect shortcuts in production)
NEXT_PUBLIC_ENABLE_INSPECT_PROTECTION=false
